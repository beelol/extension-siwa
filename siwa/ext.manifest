name: siwa

platforms:
    osx:
        context:
            frameworks: ['AuthenticationServices', 'AppKit', 'Foundation']
            flags: ["-std=c++11", "-stdlib=libc++"]
            libs: ["c++"]

    ios:
        context:
            frameworks: ['AuthenticationServices', 'Foundation', 'UIKit']
            defines:    ['SUPPORTS_SIWA']
